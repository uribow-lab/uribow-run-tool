#!/bin/bash
# urirun - YAML設定に基づいてアプリを開くランチャー
# Usage: urirun <key>
#        urirun <prefix>-<key>  (settings/<prefix>-setting.yaml から検索)

set -euo pipefail

VERSION="1.2.1"
CONFIG_DIR="$HOME/.config/uribow-lab/urirun"
CONFIG_FILE="$CONFIG_DIR/setting.yaml"
SETTINGS_DIR="$CONFIG_DIR/settings"

# --- YAML parser (simple flat 2-level) ---
parse_yaml() {
  local file="$1"
  local current_key=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\t'/  }"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^([a-zA-Z0-9_-]+):[[:space:]]*$ ]]; then
      current_key="${BASH_REMATCH[1]}"
    elif [[ -n "$current_key" && "$line" =~ ^[[:space:]]+([a-zA-Z0-9_-]+):[[:space:]]*(.+)$ ]]; then
      local field="${BASH_REMATCH[1]}"
      local value="${BASH_REMATCH[2]}"
      echo "${current_key}.${field}=${value}"
    fi
  done < "$file"
}

get_field() {
  local data="$1" key="$2" field="$3"
  local pattern="${key}.${field}="
  local line
  line=$(echo "$data" | grep "^${pattern}" | head -1)
  echo "${line#"$pattern"}"
}

# --- キー解決: setting.yaml → settings/<prefix>-setting.yaml ---
resolve_key() {
  local input="$1"

  # 1) setting.yaml から直接検索
  if [[ -f "$CONFIG_FILE" ]]; then
    local data
    data=$(parse_yaml "$CONFIG_FILE")
    local type
    type=$(get_field "$data" "$input" "type")
    if [[ -n "$type" ]]; then
      echo "$CONFIG_FILE"$'\t'"$input"
      return 0
    fi
  fi

  # 2) settings/<prefix>-setting.yaml から検索
  #    入力 "some-github" → prefix候補を長い順に試す
  #    "some-github" → "some-github"-setting.yaml (key=""), "some"-setting.yaml (key="github")
  if [[ -d "$SETTINGS_DIR" ]]; then
    local arg="$input"
    while [[ "$arg" == *-* ]]; do
      local prefix="${arg%-*}"
      local key="${input#"$prefix"-}"
      local settings_file="$SETTINGS_DIR/${prefix}-setting.yaml"
      if [[ -f "$settings_file" ]]; then
        local data
        data=$(parse_yaml "$settings_file")
        local type
        type=$(get_field "$data" "$key" "type")
        if [[ -n "$type" ]]; then
          echo "$settings_file"$'\t'"$key"
          return 0
        fi
      fi
      # prefix をさらに短くして再試行 (例: "a-b-c" → "a-b" → "a")
      arg="$prefix"
    done
  fi

  return 1
}

# --- 一覧表示 ---
list_file_keys() {
  local file="$1" prefix="$2"
  [[ -f "$file" ]] || return 0
  local data
  data=$(parse_yaml "$file")
  local seen_keys=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local full_key="${line%%.*}"
    local already=false
    for k in "${seen_keys[@]+"${seen_keys[@]}"}"; do
      [[ "$k" == "$full_key" ]] && already=true && break
    done
    $already && continue
    seen_keys+=("$full_key")
    local display_key="${prefix:+${prefix}-}${full_key}"
    local type url path desc
    type=$(get_field "$data" "$full_key" "type")
    url=$(get_field "$data" "$full_key" "url")
    path=$(get_field "$data" "$full_key" "path")
    desc=$(get_field "$data" "$full_key" "description")
    local detail="${url:-$path}"
    local line_out="  $display_key  ($type)  ${detail:+-> $detail}"
    [[ -n "$desc" ]] && line_out+="  # $desc"
    echo "$line_out" >&2
  done <<< "$data"
}

list_keys() {
  local filter="${1:-}"

  if [[ -n "$filter" ]]; then
    local settings_file="$SETTINGS_DIR/${filter}-setting.yaml"
    if [[ ! -f "$settings_file" ]]; then
      echo "Error: prefix '$filter' の設定ファイルが見つかりません" >&2
      exit 1
    fi
    echo "利用可能なキー ($filter):" >&2
    list_file_keys "$settings_file" "$filter"
    return
  fi

  echo "利用可能なキー:" >&2

  # setting.yaml
  if [[ -f "$CONFIG_FILE" ]]; then
    list_file_keys "$CONFIG_FILE" ""
  fi

  # settings/*.yaml
  if [[ -d "$SETTINGS_DIR" ]]; then
    for f in "$SETTINGS_DIR"/*-setting.yaml; do
      [[ -f "$f" ]] || continue
      local basename
      basename="$(basename "$f")"
      local prefix="${basename%-setting.yaml}"
      list_file_keys "$f" "$prefix"
    done
  fi
}

# --- Usage ---
usage() {
  echo "urirun $VERSION - YAML設定に基づくランチャー" >&2
  echo "" >&2
  echo "Usage: urirun <key>              setting.yaml のキーを実行" >&2
  echo "       urirun <prefix>-<key>     settings/<prefix>-setting.yaml のキーを実行" >&2
  echo "       urirun --list [prefix]    利用可能なキー一覧 (prefix指定で絞り込み)" >&2
  echo "       urirun --edit [prefix]    設定ファイルを編集" >&2
  echo "       urirun --shell-init" >&2
  echo "       urirun --version" >&2
  echo "" >&2
  echo "Config: $CONFIG_DIR/" >&2
}

# --- メイン ---
if [[ $# -lt 1 ]]; then
  usage
  echo "" >&2
  list_keys
  exit 0
fi

case "$1" in
  --list|-l)
    list_keys "${2:-}"
    exit 0
    ;;
  --edit|-e)
    mkdir -p "$CONFIG_DIR" "$SETTINGS_DIR"
    local_target="$CONFIG_FILE"
    if [[ -n "${2:-}" && "$2" != -* ]]; then
      local_target="$SETTINGS_DIR/${2}-setting.yaml"
    fi
    if [[ ! -f "$local_target" ]]; then
      cat > "$local_target" << 'TMPL'
# urirun 設定ファイル
# 対応type: chrome, zed, vscode, ssh, command
#
# example:
#   github:
#     type: chrome
#     profile: user@example.com
#     url: https://github.com
TMPL
    fi
    "${EDITOR:-vi}" "$local_target"
    exit 0
    ;;
  --version|-v)
    echo "urirun $VERSION" >&2
    exit 0
    ;;
  --shell-init)
    URIRUN_BIN=$(command -v urirun 2>/dev/null || echo "$0")
    cat << SHELLINIT
urirun() {
  local _urirun_eval_file="/tmp/.urirun_eval_\$\$"
  rm -f "\$_urirun_eval_file"
  URIRUN_EVAL_FILE="\$_urirun_eval_file" command urirun "\$@"
  local rc=\$?
  if [[ -f "\$_urirun_eval_file" ]]; then
    eval "\$(cat "\$_urirun_eval_file")"
    rm -f "\$_urirun_eval_file"
  fi
  return \$rc
}
SHELLINIT
    exit 0
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  -*)
    echo "Error: 不明なオプション '$1'" >&2
    usage
    exit 1
    ;;
esac

INPUT_KEY="$1"

# キー解決
RESOLVED=$(resolve_key "$INPUT_KEY") || {
  echo "Error: キー '$INPUT_KEY' が見つかりません" >&2
  echo "" >&2
  list_keys
  exit 1
}

RESOLVED_FILE=$(echo "$RESOLVED" | cut -f1)
KEY=$(echo "$RESOLVED" | cut -f2)
DATA=$(parse_yaml "$RESOLVED_FILE")

TYPE=$(get_field "$DATA" "$KEY" "type")
PROFILE=$(get_field "$DATA" "$KEY" "profile")
URL=$(get_field "$DATA" "$KEY" "url")
TARGET_PATH=$(get_field "$DATA" "$KEY" "path")
WORKSPACE=$(get_field "$DATA" "$KEY" "workspace")
SSH_CONFIG=$(get_field "$DATA" "$KEY" "config")

case "$TYPE" in
  chrome)
    if [[ -z "$URL" ]]; then
      echo "Error: chrome には url が必要です" >&2
      exit 1
    fi

    CHROME_DIR="$HOME/Library/Application Support/Google/Chrome"
    PROFILE_DIR=""

    if [[ -n "$PROFILE" ]]; then
      for dir in "$CHROME_DIR"/Default "$CHROME_DIR"/Profile\ *; do
        [[ -f "$dir/Preferences" ]] || continue
        primary_email=$(
          grep -o '"email"[[:space:]]*:[[:space:]]*"[^"]*"' "$dir/Preferences" 2>/dev/null \
          | head -1 \
          | sed 's/.*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
        )
        if [[ "$primary_email" == "$PROFILE" ]]; then
          PROFILE_DIR="$(basename "$dir")"
          break
        fi
      done

      if [[ -z "$PROFILE_DIR" ]]; then
        echo "Error: Chromeプロファイルが見つかりません: $PROFILE" >&2
        exit 1
      fi

      echo "[$INPUT_KEY] Chrome ($PROFILE_DIR / $PROFILE) -> $URL" >&2
      /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --profile-directory="$PROFILE_DIR" \
        "$URL" >/dev/null 2>&1 &
      disown
    else
      echo "[$INPUT_KEY] Chrome -> $URL" >&2
      open -a "Google Chrome" "$URL"
    fi
    ;;

  zed)
    if [[ -z "$TARGET_PATH" ]]; then
      echo "Error: zed には path が必要です" >&2
      exit 1
    fi
    if [[ ! -d "$TARGET_PATH" ]]; then
      echo "Error: パスが存在しません: $TARGET_PATH" >&2
      exit 1
    fi
    echo "[$INPUT_KEY] Zed -> $TARGET_PATH" >&2
    zed "$TARGET_PATH"
    ;;

  vscode)
    VSCODE_CMD=$(get_field "$DATA" "$KEY" "command")
    VSCODE_CMD="${VSCODE_CMD:-code}"
    if [[ -n "$WORKSPACE" ]]; then
      echo "[$INPUT_KEY] VS Code ($VSCODE_CMD, workspace) -> $WORKSPACE" >&2
      "$VSCODE_CMD" "$WORKSPACE"
    elif [[ -n "$TARGET_PATH" ]]; then
      if [[ ! -d "$TARGET_PATH" ]]; then
        echo "Error: パスが存在しません: $TARGET_PATH" >&2
        exit 1
      fi
      echo "[$INPUT_KEY] VS Code ($VSCODE_CMD) -> $TARGET_PATH" >&2
      "$VSCODE_CMD" "$TARGET_PATH"
    else
      echo "Error: vscode には workspace または path が必要です" >&2
      exit 1
    fi
    ;;

  ssh)
    if [[ -z "$SSH_CONFIG" ]]; then
      echo "Error: ssh には config (Host名) が必要です" >&2
      exit 1
    fi
    if [[ -n "$TARGET_PATH" ]]; then
      echo "[$INPUT_KEY] SSH -> $SSH_CONFIG (cd $TARGET_PATH)" >&2
      ssh -t "$SSH_CONFIG" "cd $TARGET_PATH && exec \$SHELL -l"
    else
      echo "[$INPUT_KEY] SSH -> $SSH_CONFIG" >&2
      ssh "$SSH_CONFIG"
    fi
    ;;

  command)
    COMMANDS=$(get_field "$DATA" "$KEY" "commands")
    if [[ -z "$COMMANDS" ]]; then
      echo "Error: command には commands が必要です" >&2
      exit 1
    fi
    echo "[$INPUT_KEY] Command -> $COMMANDS" >&2
    IFS=';' read -ra CMD_LIST <<< "$COMMANDS"
    EVAL_CMDS=""
    for cmd in "${CMD_LIST[@]}"; do
      cmd=$(echo "$cmd" | xargs)
      [[ -z "$cmd" ]] && continue
      echo "  > $cmd" >&2
      EVAL_CMDS+="$cmd"$'\n'
    done
    if [[ -n "${URIRUN_EVAL_FILE:-}" ]]; then
      printf '%s' "$EVAL_CMDS" > "$URIRUN_EVAL_FILE"
    else
      printf '%s' "$EVAL_CMDS"
    fi
    ;;

  *)
    echo "Error: 未対応のtype '$TYPE'" >&2
    exit 1
    ;;
esac
