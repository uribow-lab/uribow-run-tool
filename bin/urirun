#!/bin/bash
# urirun - YAML設定に基づいてアプリを開くランチャー
# Usage: urirun <key>
#        urirun <プロジェクト>-<key>  (settings/<プロジェクト>-setting.yaml から検索)

set -euo pipefail

VERSION="1.4.0"
CONFIG_DIR="$HOME/.config/uribow-lab/urirun"
CONFIG_FILE="$CONFIG_DIR/setting.yaml"
SETTINGS_DIR="$CONFIG_DIR/settings"

# --- YAML parser ---
# 新書式:
#   name: ...
#   description: ...
#   keys:
#     <key>:
#       type: ...
#       ...
# 出力:
#   __root__.<field>=<value>   (トップレベルの name, description 等)
#   <key>.<field>=<value>      (keys: 配下の各キーのフィールド)
parse_yaml() {
  local file="$1"
  local current_key=""
  local in_keys=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line//$'\t'/  }"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^(\ *)([a-zA-Z0-9_-]+):[[:space:]]*(.*)$ ]]; then
      local indent_str="${BASH_REMATCH[1]}"
      local name="${BASH_REMATCH[2]}"
      local value="${BASH_REMATCH[3]}"
      local indent=${#indent_str}

      if (( indent == 0 )); then
        if [[ "$name" == "keys" && -z "$value" ]]; then
          in_keys=1
          current_key=""
        elif [[ -n "$value" ]]; then
          echo "__root__.${name}=${value}"
          in_keys=0
          current_key=""
        fi
      elif (( in_keys )) && (( indent == 2 )) && [[ -z "$value" ]]; then
        current_key="$name"
      elif (( in_keys )) && (( indent == 4 )) && [[ -n "$value" ]] && [[ -n "$current_key" ]]; then
        echo "${current_key}.${name}=${value}"
      fi
    fi
  done < "$file"
}

get_field() {
  local data="$1" key="$2" field="$3"
  local pattern="${key}.${field}="
  local line
  line=$(echo "$data" | grep "^${pattern}" | head -1)
  echo "${line#"$pattern"}"
}

get_root_field() {
  local data="$1" field="$2"
  local pattern="__root__.${field}="
  local line
  line=$(echo "$data" | grep "^${pattern}" | head -1)
  echo "${line#"$pattern"}"
}

# --- キー解決: setting.yaml → settings/<prefix>-setting.yaml ---
resolve_key() {
  local input="$1"

  # 1) setting.yaml から直接検索
  if [[ -f "$CONFIG_FILE" ]]; then
    local data
    data=$(parse_yaml "$CONFIG_FILE")
    local type
    type=$(get_field "$data" "$input" "type")
    if [[ -n "$type" ]]; then
      echo "$CONFIG_FILE"$'\t'"$input"
      return 0
    fi
  fi

  # 2) settings/<prefix>-setting.yaml から検索
  #    入力 "some-github" → prefix候補を長い順に試す
  #    "some-github" → "some-github"-setting.yaml (key=""), "some"-setting.yaml (key="github")
  if [[ -d "$SETTINGS_DIR" ]]; then
    local arg="$input"
    while [[ "$arg" == *-* ]]; do
      local prefix="${arg%-*}"
      local key="${input#"$prefix"-}"
      local settings_file="$SETTINGS_DIR/${prefix}-setting.yaml"
      if [[ -f "$settings_file" ]]; then
        local data
        data=$(parse_yaml "$settings_file")
        local type
        type=$(get_field "$data" "$key" "type")
        if [[ -n "$type" ]]; then
          echo "$settings_file"$'\t'"$key"
          return 0
        fi
      fi
      # prefix をさらに短くして再試行 (例: "a-b-c" → "a-b" → "a")
      arg="$prefix"
    done
  fi

  return 1
}

# --- 一覧表示 ---
list_file_keys() {
  local file="$1" prefix="$2"
  [[ -f "$file" ]] || return 0
  local data
  data=$(parse_yaml "$file")
  local seen_keys=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local full_key="${line%%.*}"
    [[ "$full_key" == "__root__" ]] && continue
    local already=false
    for k in "${seen_keys[@]+"${seen_keys[@]}"}"; do
      [[ "$k" == "$full_key" ]] && already=true && break
    done
    $already && continue
    seen_keys+=("$full_key")
    local display_key="${prefix:+${prefix}-}${full_key}"
    local type url path desc
    type=$(get_field "$data" "$full_key" "type")
    url=$(get_field "$data" "$full_key" "url")
    path=$(get_field "$data" "$full_key" "path")
    desc=$(get_field "$data" "$full_key" "description")
    desc=$(strip_quotes "$desc")
    local detail="${url:-$path}"
    local line_out="  $display_key  ($type)  ${detail:+-> $detail}"
    [[ -n "$desc" ]] && line_out+="  $desc"
    echo "$line_out" >&2
  done <<< "$data"
}

list_keys() {
  local filter="${1:-}"

  if [[ -n "$filter" ]]; then
    local settings_file="$SETTINGS_DIR/${filter}-setting.yaml"
    if [[ ! -f "$settings_file" ]]; then
      echo "Error: プロジェクト '$filter' の設定ファイルが見つかりません" >&2
      exit 1
    fi
    local data pname
    data=$(parse_yaml "$settings_file")
    pname=$(get_root_field "$data" "name")
    pname=$(strip_quotes "$pname")
    if [[ -n "$pname" ]]; then
      echo "利用可能なキー [$filter] $pname:" >&2
    else
      echo "利用可能なキー [$filter]:" >&2
    fi
    list_file_keys "$settings_file" "$filter"
    return
  fi

  echo "利用可能なキー:" >&2

  # setting.yaml
  if [[ -f "$CONFIG_FILE" ]]; then
    list_file_keys "$CONFIG_FILE" ""
  fi

  # settings/*.yaml
  if [[ -d "$SETTINGS_DIR" ]]; then
    for f in "$SETTINGS_DIR"/*-setting.yaml; do
      [[ -f "$f" ]] || continue
      local basename
      basename="$(basename "$f")"
      local prefix="${basename%-setting.yaml}"
      list_file_keys "$f" "$prefix"
    done
  fi
}

# --- インタラクティブ選択 ---

SELECTED_INDEX=-1
SEL_ITEMS=()
SEL_TYPES=()
SEL_VALUES=()
INTERACTIVE_KEY=""

interactive_select() {
  local title="$1"; shift
  local items=("$@")
  local count=${#items[@]}
  SELECTED_INDEX=-1
  [[ $count -eq 0 ]] && return 1

  exec 3</dev/tty || {
    echo "Error: インタラクティブ選択は端末からのみ利用可能です" >&2
    return 1
  }

  printf '\033[?25l' >&2
  printf '%s\n' "$title" >&2
  printf '%s\n' "  (↑/↓ k/j: 選択、←/h: 戻る、Enter: 決定、q/ESC: キャンセル)" >&2

  local i
  local idx=0
  for ((i=0; i<count; i++)); do
    if [[ $i -eq $idx ]]; then
      printf '\033[7m▶ %s\033[0m\n' "${items[i]}" >&2
    else
      printf '  %s\n' "${items[i]}" >&2
    fi
  done

  local result=-1
  while true; do
    local k1 k2=""
    if ! IFS= read -rsn1 k1 <&3; then
      result=-1; break
    fi
    case "$k1" in
      $'\x1b')
        if IFS= read -rsn2 -t 1 k2 <&3 2>/dev/null; then
          case "$k2" in
            '[A') if (( idx > 0 )); then idx=$((idx-1)); fi ;;
            '[B') if (( idx < count-1 )); then idx=$((idx+1)); fi ;;
            '[D') result=-2; break ;;
            *) result=-1; break ;;
          esac
        else
          result=-1; break
        fi
        ;;
      '')
        result=$idx; break ;;
      q|Q)
        result=-1; break ;;
      h|H)
        result=-2; break ;;
      j)
        if (( idx < count-1 )); then idx=$((idx+1)); fi ;;
      k)
        if (( idx > 0 )); then idx=$((idx-1)); fi ;;
    esac

    printf '\033[%dA' "$count" >&2
    for ((i=0; i<count; i++)); do
      printf '\033[2K' >&2
      if [[ $i -eq $idx ]]; then
        printf '\033[7m▶ %s\033[0m\n' "${items[i]}" >&2
      else
        printf '  %s\n' "${items[i]}" >&2
      fi
    done
  done

  printf '\033[?25h' >&2
  exec 3<&-

  if (( result == -2 )); then
    return 2
  fi
  if (( result < 0 )); then
    return 130
  fi
  SELECTED_INDEX=$result
  return 0
}

strip_quotes() {
  local s="$1"
  s="${s#\"}"; s="${s%\"}"
  s="${s#\'}"; s="${s%\'}"
  printf '%s' "$s"
}

# _KEY_COL / _DESC_COL から、縦位置を揃えた SEL_ITEMS を構築する
format_sel_items() {
  SEL_ITEMS=()
  local n=${#_KEY_COL[@]}
  (( n == 0 )) && return 0

  local max_key=0
  local i
  for ((i=0; i<n; i++)); do
    (( ${#_KEY_COL[i]} > max_key )) && max_key=${#_KEY_COL[i]}
  done

  for ((i=0; i<n; i++)); do
    local line
    if [[ -n "${_DESC_COL[i]}" ]]; then
      line=$(printf "%-${max_key}s  %s" "${_KEY_COL[i]}" "${_DESC_COL[i]}")
    else
      line="${_KEY_COL[i]}"
    fi
    SEL_ITEMS+=("$line")
  done
}

# キー配下の description を取得。description が空/未設定なら (type) を返す。
key_display_right() {
  local data="$1" key="$2"
  local desc type
  desc=$(get_field "$data" "$key" "description")
  desc=$(strip_quotes "$desc")
  if [[ -n "$desc" ]]; then
    printf '%s' "$desc"
  else
    type=$(get_field "$data" "$key" "type")
    printf '(%s)' "$type"
  fi
}

collect_top_level() {
  SEL_ITEMS=()
  SEL_TYPES=()
  SEL_VALUES=()
  _KEY_COL=()
  _DESC_COL=()

  if [[ -f "$CONFIG_FILE" ]]; then
    local data
    data=$(parse_yaml "$CONFIG_FILE")
    local seen_keys=()
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local full_key="${line%%.*}"
      [[ "$full_key" == "__root__" ]] && continue
      local already=false
      local k
      for k in "${seen_keys[@]+"${seen_keys[@]}"}"; do
        [[ "$k" == "$full_key" ]] && already=true && break
      done
      $already && continue
      seen_keys+=("$full_key")
      _KEY_COL+=("$full_key")
      _DESC_COL+=("$(key_display_right "$data" "$full_key")")
      SEL_TYPES+=("key")
      SEL_VALUES+=("$full_key")
    done <<< "$data"
  fi

  if [[ -d "$SETTINGS_DIR" ]]; then
    local f
    for f in "$SETTINGS_DIR"/*-setting.yaml; do
      [[ -f "$f" ]] || continue
      local basename
      basename="$(basename "$f")"
      local pfx="${basename%-setting.yaml}"
      local pdata pname
      pdata=$(parse_yaml "$f")
      pname=$(get_root_field "$pdata" "name")
      pname=$(strip_quotes "$pname")
      _KEY_COL+=("[$pfx]")
      _DESC_COL+=("$pname")
      SEL_TYPES+=("prefix")
      SEL_VALUES+=("$pfx")
    done
  fi

  format_sel_items
}

collect_prefix_keys() {
  local prefix="$1"
  local settings_file="$SETTINGS_DIR/${prefix}-setting.yaml"
  SEL_ITEMS=()
  SEL_TYPES=()
  SEL_VALUES=()
  _KEY_COL=()
  _DESC_COL=()
  [[ -f "$settings_file" ]] || return 1

  local data
  data=$(parse_yaml "$settings_file")
  local seen_keys=()
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local full_key="${line%%.*}"
    [[ "$full_key" == "__root__" ]] && continue
    local already=false
    local k
    for k in "${seen_keys[@]+"${seen_keys[@]}"}"; do
      [[ "$k" == "$full_key" ]] && already=true && break
    done
    $already && continue
    seen_keys+=("$full_key")
    _KEY_COL+=("$full_key")
    _DESC_COL+=("$(key_display_right "$data" "$full_key")")
    SEL_TYPES+=("key")
    SEL_VALUES+=("$full_key")
  done <<< "$data"

  format_sel_items
}

run_interactive() {
  local prefix="${1:-}"
  INTERACTIVE_KEY=""

  while true; do
    if [[ -z "$prefix" ]]; then
      collect_top_level
    else
      collect_prefix_keys "$prefix" || {
        echo "Error: プロジェクト '$prefix' の設定ファイルが見つかりません" >&2
        return 1
      }
    fi

    if [[ ${#SEL_ITEMS[@]} -eq 0 ]]; then
      if [[ -z "$prefix" ]]; then
        echo "利用可能なキーがありません。'urirun --edit' で設定してください。" >&2
      else
        echo "'$prefix' にキーがありません。" >&2
      fi
      return 1
    fi

    local title
    if [[ -z "$prefix" ]]; then
      title="利用可能なキーを選択してください:"
    else
      local pdata pname
      pdata=$(parse_yaml "$SETTINGS_DIR/${prefix}-setting.yaml")
      pname=$(get_root_field "$pdata" "name")
      pname=$(strip_quotes "$pname")
      if [[ -n "$pname" ]]; then
        title="[$prefix] $pname のキーを選択してください:"
      else
        title="[$prefix] キーを選択してください:"
      fi
    fi

    local items_copy=("${SEL_ITEMS[@]}")
    local types_copy=("${SEL_TYPES[@]}")
    local values_copy=("${SEL_VALUES[@]}")

    interactive_select "$title" "${items_copy[@]}"
    local rc=$?

    if (( rc == 130 )); then
      return 130
    fi
    if (( rc == 2 )); then
      if [[ -n "$prefix" ]]; then
        prefix=""
        continue
      fi
      continue
    fi

    local selected=$SELECTED_INDEX
    local sel_type="${types_copy[selected]}"
    local sel_value="${values_copy[selected]}"

    if [[ "$sel_type" == "prefix" ]]; then
      prefix="$sel_value"
      continue
    fi

    if [[ -z "$prefix" ]]; then
      INTERACTIVE_KEY="$sel_value"
    else
      INTERACTIVE_KEY="${prefix}-${sel_value}"
    fi
    return 0
  done
}

# --- Usage ---
usage() {
  echo "urirun $VERSION - YAML設定に基づくランチャー" >&2
  echo "" >&2
  echo "Usage: urirun <key>                   setting.yaml のキーを実行" >&2
  echo "       urirun <プロジェクト>-<key>    settings/<プロジェクト>-setting.yaml のキーを実行" >&2
  echo "       urirun --list [プロジェクト]   利用可能なキー一覧 (プロジェクト指定で絞り込み)" >&2
  echo "       urirun --edit [プロジェクト]   設定ファイルを編集" >&2
  echo "       urirun --shell-init" >&2
  echo "       urirun --version" >&2
  echo "" >&2
  echo "Config: $CONFIG_DIR/" >&2
}

# --- メイン ---
if [[ $# -lt 1 ]]; then
  if [[ -t 1 ]] && [[ -r /dev/tty ]]; then
    if ! run_interactive; then
      exit 0
    fi
    INPUT_KEY="$INTERACTIVE_KEY"
    set -- "$INPUT_KEY"
  else
    usage
    echo "" >&2
    list_keys
    exit 0
  fi
fi

case "$1" in
  --list|-l)
    list_keys "${2:-}"
    exit 0
    ;;
  --edit|-e)
    mkdir -p "$CONFIG_DIR" "$SETTINGS_DIR"
    local_target="$CONFIG_FILE"
    if [[ -n "${2:-}" && "$2" != -* ]]; then
      local_target="$SETTINGS_DIR/${2}-setting.yaml"
    fi
    if [[ ! -f "$local_target" ]]; then
      cat > "$local_target" << 'TMPL'
# urirun 設定ファイル
# 対応type: chrome, zed, vscode, ssh, command

name: Personal
description: 個人用設定
keys:
  # example:
  #   github:
  #     type: chrome
  #     profile: user@example.com
  #     url: https://github.com
  #     description: GitHub を開く
TMPL
    fi
    "${EDITOR:-vi}" "$local_target"
    exit 0
    ;;
  --version|-v)
    echo "urirun $VERSION" >&2
    exit 0
    ;;
  --shell-init)
    URIRUN_BIN=$(command -v urirun 2>/dev/null || echo "$0")
    cat << SHELLINIT
urirun() {
  local _urirun_eval_file="/tmp/.urirun_eval_\$\$"
  rm -f "\$_urirun_eval_file"
  URIRUN_EVAL_FILE="\$_urirun_eval_file" command urirun "\$@"
  local rc=\$?
  if [[ -f "\$_urirun_eval_file" ]]; then
    eval "\$(cat "\$_urirun_eval_file")"
    rm -f "\$_urirun_eval_file"
  fi
  return \$rc
}
SHELLINIT
    exit 0
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  -*)
    echo "Error: 不明なオプション '$1'" >&2
    usage
    exit 1
    ;;
esac

INPUT_KEY="$1"

# プレフィックス単体で呼ばれた場合、直接キーとして解決できなければインタラクティブに切替
if [[ -f "$SETTINGS_DIR/${INPUT_KEY}-setting.yaml" ]] && [[ -t 1 ]] && [[ -r /dev/tty ]]; then
  if ! resolve_key "$INPUT_KEY" >/dev/null 2>&1; then
    if ! run_interactive "$INPUT_KEY"; then
      exit 0
    fi
    INPUT_KEY="$INTERACTIVE_KEY"
  fi
fi

# キー解決
RESOLVED=$(resolve_key "$INPUT_KEY") || {
  echo "Error: キー '$INPUT_KEY' が見つかりません" >&2
  echo "" >&2
  list_keys
  exit 1
}

RESOLVED_FILE=$(echo "$RESOLVED" | cut -f1)
KEY=$(echo "$RESOLVED" | cut -f2)
DATA=$(parse_yaml "$RESOLVED_FILE")

TYPE=$(get_field "$DATA" "$KEY" "type")
PROFILE=$(get_field "$DATA" "$KEY" "profile")
URL=$(get_field "$DATA" "$KEY" "url")
TARGET_PATH=$(get_field "$DATA" "$KEY" "path")
WORKSPACE=$(get_field "$DATA" "$KEY" "workspace")
SSH_CONFIG=$(get_field "$DATA" "$KEY" "config")

case "$TYPE" in
  chrome)
    if [[ -z "$URL" ]]; then
      echo "Error: chrome には url が必要です" >&2
      exit 1
    fi

    CHROME_DIR="$HOME/Library/Application Support/Google/Chrome"
    PROFILE_DIR=""

    if [[ -n "$PROFILE" ]]; then
      for dir in "$CHROME_DIR"/Default "$CHROME_DIR"/Profile\ *; do
        [[ -f "$dir/Preferences" ]] || continue
        primary_email=$(
          grep -o '"email"[[:space:]]*:[[:space:]]*"[^"]*"' "$dir/Preferences" 2>/dev/null \
          | head -1 \
          | sed 's/.*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
        )
        if [[ "$primary_email" == "$PROFILE" ]]; then
          PROFILE_DIR="$(basename "$dir")"
          break
        fi
      done

      if [[ -z "$PROFILE_DIR" ]]; then
        echo "Error: Chromeプロファイルが見つかりません: $PROFILE" >&2
        exit 1
      fi

      echo "[$INPUT_KEY] Chrome ($PROFILE_DIR / $PROFILE) -> $URL" >&2
      /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
        --profile-directory="$PROFILE_DIR" \
        "$URL" >/dev/null 2>&1 &
      disown
    else
      echo "[$INPUT_KEY] Chrome -> $URL" >&2
      open -a "Google Chrome" "$URL"
    fi
    ;;

  zed)
    if [[ -z "$TARGET_PATH" ]]; then
      echo "Error: zed には path が必要です" >&2
      exit 1
    fi
    if [[ ! -d "$TARGET_PATH" ]]; then
      echo "Error: パスが存在しません: $TARGET_PATH" >&2
      exit 1
    fi
    echo "[$INPUT_KEY] Zed -> $TARGET_PATH" >&2
    zed "$TARGET_PATH"
    ;;

  vscode)
    VSCODE_CMD=$(get_field "$DATA" "$KEY" "command")
    VSCODE_CMD="${VSCODE_CMD:-code}"
    if [[ -n "$WORKSPACE" ]]; then
      echo "[$INPUT_KEY] VS Code ($VSCODE_CMD, workspace) -> $WORKSPACE" >&2
      "$VSCODE_CMD" "$WORKSPACE"
    elif [[ -n "$TARGET_PATH" ]]; then
      if [[ ! -d "$TARGET_PATH" ]]; then
        echo "Error: パスが存在しません: $TARGET_PATH" >&2
        exit 1
      fi
      echo "[$INPUT_KEY] VS Code ($VSCODE_CMD) -> $TARGET_PATH" >&2
      "$VSCODE_CMD" "$TARGET_PATH"
    else
      echo "Error: vscode には workspace または path が必要です" >&2
      exit 1
    fi
    ;;

  ssh)
    if [[ -z "$SSH_CONFIG" ]]; then
      echo "Error: ssh には config (Host名) が必要です" >&2
      exit 1
    fi
    if [[ -n "$TARGET_PATH" ]]; then
      echo "[$INPUT_KEY] SSH -> $SSH_CONFIG (cd $TARGET_PATH)" >&2
      ssh -t "$SSH_CONFIG" "cd $TARGET_PATH && exec \$SHELL -l"
    else
      echo "[$INPUT_KEY] SSH -> $SSH_CONFIG" >&2
      ssh "$SSH_CONFIG"
    fi
    ;;

  command)
    COMMANDS=$(get_field "$DATA" "$KEY" "commands")
    if [[ -z "$COMMANDS" ]]; then
      echo "Error: command には commands が必要です" >&2
      exit 1
    fi
    echo "[$INPUT_KEY] Command -> $COMMANDS" >&2
    IFS=';' read -ra CMD_LIST <<< "$COMMANDS"
    EVAL_CMDS=""
    for cmd in "${CMD_LIST[@]}"; do
      cmd=$(echo "$cmd" | xargs)
      [[ -z "$cmd" ]] && continue
      echo "  > $cmd" >&2
      EVAL_CMDS+="$cmd"$'\n'
    done
    if [[ -n "${URIRUN_EVAL_FILE:-}" ]]; then
      printf '%s' "$EVAL_CMDS" > "$URIRUN_EVAL_FILE"
    else
      printf '%s' "$EVAL_CMDS"
    fi
    ;;

  *)
    echo "Error: 未対応のtype '$TYPE'" >&2
    exit 1
    ;;
esac
